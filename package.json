{
  "name": "books-rest-api",
  "version": "1.0.0",
  "description": "A production-minded REST API for managing a book catalog, built with Node.js, Express and TypeScript.",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "rest-api",
    "crud",
    "zod",
    "portfolio"
  ],
  "author": "Peter Cordova (https://github.com/petercordovadev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petercordovadev/books-rest-api.git"
  },
  "bugs": {
    "url": "https://github.com/petercordovadev/books-rest-api/issues"
  },
  "homepage": "https://github.com/petercordovadev/books-rest-api#readme",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
