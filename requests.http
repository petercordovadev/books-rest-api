@baseUrl = http://localhost:3000
@contentType = application/json

### Health check
GET {{baseUrl}}/health

### API metadata
GET {{baseUrl}}/

### List every book
GET {{baseUrl}}/api/v1/books

### Get a book by id
GET {{baseUrl}}/api/v1/books/1

### Get a missing book (404)
GET {{baseUrl}}/api/v1/books/999

### Invalid id (400)
GET {{baseUrl}}/api/v1/books/not-a-number

### Create a book
POST {{baseUrl}}/api/v1/books
Content-Type: {{contentType}}

{
  "title": "The Pragmatic Programmer",
  "author": "Andrew Hunt and David Thomas",
  "year": 1999
}

### Create a book with a client-supplied id (400)
POST {{baseUrl}}/api/v1/books
Content-Type: {{contentType}}

{
  "id": 999,
  "title": "Invalid",
  "author": "Unknown",
  "year": 2020
}

### Replace a book
PUT {{baseUrl}}/api/v1/books/1
Content-Type: {{contentType}}

{
  "title": "The Great Gatsby",
  "author": "F. Scott Fitzgerald",
  "year": 1925
}

### Update a single field
PATCH {{baseUrl}}/api/v1/books/1
Content-Type: {{contentType}}

{
  "year": 1926
}

### Delete a book
DELETE {{baseUrl}}/api/v1/books/5

### Malformed JSON (400)
POST {{baseUrl}}/api/v1/books
Content-Type: {{contentType}}

{ bad json

### Unknown route (404)
GET {{baseUrl}}/api/v1/unknown
